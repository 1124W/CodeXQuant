WECOM_WEBHOOK_URL=
CODEXQUANT_STRATEGY=consensus
CODEXQUANT_MODEL_DIR=/var/lib/codexquant/models-consensus/initial
CODEXQUANT_STATE_DIR=/var/lib/codexquant
# New paper admissions only; prior trades retain their original amounts.
# Range 5.00 through 250.00 USDT; daily risk defaults to five times this amount.
CODEXQUANT_PAPER_STAKE=30
# Temporary deployment guard: when this file exists, block new paper admissions.
CODEXQUANT_PUBLICATION_HOLD_FILE=/var/lib/codexquant/publication-hold
CODEXQUANT_PUBLIC_BASE_URL=https://nightsleep.eu.org
